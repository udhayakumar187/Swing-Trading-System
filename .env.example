# Angel One Credentials (NEVER commit real values)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Trading Mode - DRY_RUN is default and mandatory for safety
TRADING_MODE=DRY_RUN

# Portfolio Configuration
TOTAL_PORTFOLIO_CAPITAL=100000
MAX_RISK_PERCENT=0.01
MAX_DAILY_LOSS_PERCENT=0.02
MAX_OPEN_POSITIONS=3
MAX_STOP_LOSS_PERCENT=0.08
MIN_RISK_REWARD=2.0

# Execution Settings
SIGNAL_EXECUTION_TIME=15:45
TIMEZONE=Asia/Kolkata

# Database
DATABASE_URL=sqlite:///./trading.db

# Supabase Configuration (for pattern tracking)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Pattern Scanner Configuration
PATTERN_SCAN_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS
PATTERN_SCAN_TIMEFRAME=1d
PATTERN_SCAN_LOOKBACK_DAYS=200
PATTERN_FORWARD_DAYS=20

# Swing Low Lookback
SWING_LOW_LOOKBACK=5

# Corporate Event Exclusion Window (days)
EVENT_EXCLUSION_WINDOW=7

# Logging
LOG_LEVEL=INFO